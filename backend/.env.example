# Optional local example. No dotenv file is loaded automatically.
# Pass this file explicitly using uv run --env-file .env, or export the variables.
COUNTY_ENVIRONMENT=development
COUNTY_LOG_LEVEL=INFO
COUNTY_CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173"]'

# Missing URL is allowed: live=200, ready=503. Supply your own synthetic local
# credentials through ignored configuration; URLs require postgresql+psycopg.
# COUNTY_DATABASE_URL=
# Never pass migration credentials to the running application process.
# COUNTY_MIGRATION_DATABASE_URL=
COUNTY_DB_CONNECT_TIMEOUT_SECONDS=5
COUNTY_DB_POOL_TIMEOUT_SECONDS=5
COUNTY_DB_POOL_SIZE=5
COUNTY_DB_MAX_OVERFLOW=5
COUNTY_DB_READINESS_TIMEOUT_SECONDS=10

# P3-01: deterministic synthetic provider, no model or network required.
AI_PROVIDER=fake
AI_MODEL=fake-v1
AI_TIMEOUT_SECONDS=5
AI_MAX_OUTPUT_TOKENS=512
AI_MAX_CONCURRENCY=2

# P3-02: opt-in host-local Ollama, only after exact-exposure runtime authorization.
# AI_PROVIDER=ollama
# AI_MODEL=llama3.2:3b
# AI_ALLOWED_MODELS='["llama3.2:3b"]'
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_CONTEXT_TOKENS=8192
# AI_TIMEOUT_SECONDS=60
AI_MAX_RESPONSE_BYTES=65536
