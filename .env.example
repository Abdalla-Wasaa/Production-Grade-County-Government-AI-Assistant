# Compose: run python3 scripts/dev.py setup; do not copy this file to .env.
# The helper writes a non-secret .env and private .local/compose/secrets files.
# COMPOSE_PROJECT_NAME=county-dev
# COUNTY_HTTP_PORT=8080
# COUNTY_INSTANCE_ID=<generated unique ownership marker>
# COUNTY_SECRET_DIR=<absolute private directory generated by setup>
# COMPOSE_BAKE=false
# Application settings for non-container development: backend/.env.example.
# Frontend build configuration: frontend/.env.example. No browser secrets.
