      "python-dependency-audit"
    ],
    "frontend.yml": [
      "frontend-quality"
    ],
    "compose.yml": [
      "compose-integration"
    ],
    "documentation.yml": [
      "repository-quality",
      "secret-scan"
    ]
  },
  "action_pins": {
    "actions/checkout": "11d5960a326750d5838078e36cf38b85af677262",
    "actions/setup-python": "a26af69be951a213d495a4c3e4e4022e16d87065",
    "actions/setup-node": "249970729cb0ef3589644e2896645e5dc5ba9c38",
    "actions/upload-artifact": "ea165f8d65b6e75b540449e92b4886f43607fa02",
    "actions/cache/restore": "0057852bfaa89a56745cba8c7296529d2fc39830",
    "actions/cache/save": "0057852bfaa89a56745cba8c7296529d2fc39830"
  },
  "artifact_paths": [
    "backend/.artifacts/*.xml",
    "frontend/.artifacts/",
    ".artifacts/",
    "${{ runner.temp }}/county-image-scans/*.json"
  ],
  "command_contracts": {
    "compose.yml/compose-integration": {
      "Install and verify approved frontend toolchain": [
        [
          "test",
          "$(node --version)",
          "=",
          "v24.22.0"
        ],
        [
          "test",
          "$(npm --version)",
          "=",
          "11.19.1"
        ],
        [
          "npm",
          "--prefix",
          "frontend",
          "ci"
        ],
        [
          "npm",
          "--prefix",
          "frontend",
          "ls",
          "--all"
        ]
      ],
      "Verify Docker and install Chromium": [
        [
          "docker",
          "version"
        ],
        [
          "docker",
          "compose",
          "version"
        ],
        [
          "docker",
          "buildx",
          "version"
        ],
        [
          "cd",
          "frontend"
        ],
        [
          "npx",
          "--no-install",
          "playwright",
          "install",
          "--with-deps",
          "chromium"
        ]
      ],
      "Container unit tests": [
        [
          "python3",
          "scripts/dev.py",
          "test-frontend"
        ],
        [
          "python3",
          "scripts/dev.py",
          "test-backend"
        ]
      ],
      "Compose integration and Nginx browser smoke": [
        [
          "python3",
          "scripts/compose_smoke.py",
          "--browser",
          "--report",
          "$RUNNER_TEMP/county-images.json",
          "--cleanup-manifest",
          "$RUNNER_TEMP/county-cleanup.json",
          "--diagnostics",
          ".artifacts/compose-diagnostics.json"
        ]
      ],
      "Install checksum-verified Trivy": [
        [
          "mkdir",
          "-p",
          "$RUNNER_TEMP/trivy"
        ],
        [
          "curl",
          "--fail",
          "--silent",
          "--show-error",
          "--location",
          "--retry",
          "3",
          "https://github.com/aquasecurity/trivy/releases/download/v0.76.0/trivy_0.76.0_Linux-64bit.tar.gz",
          "-o",
          "$RUNNER_TEMP/trivy/trivy.tar.gz"
        ],
        [
          "echo",
          "e24b1c51293c1b15e4ba8d45bbc7891ba053f90278ec2698f3562c993e145fe7  $RUNNER_TEMP/trivy/trivy.tar.gz",
          "|",
          "sha256sum",
          "--check",
          "--strict"
        ],
        [
          "tar",
          "-xzf",
          "$RUNNER_TEMP/trivy/trivy.tar.gz",
          "-C",
          "$RUNNER_TEMP/trivy",
          "trivy"
        ],
        [
          "echo",
          "$RUNNER_TEMP/trivy",
          ">>",
          "$GITHUB_PATH"
        ]
      ],
      "Complete image reports and development security decision": [
        [
          "python3",
          "scripts/scan_images.py",
          "$RUNNER_TEMP/county-images.json",
          "--output",
          ".artifacts/image-scans"
        ]
      ],
      "Validate and sanitize Nginx browser report": [
        [
          "python3",
          "scripts/check_test_report.py",
          "--sanitize",
          "frontend/.artifacts/compose-browser.xml"
        ]
      ],
      "Cleanup verified disposable resources": [
        [
          "python3",
          "scripts/compose_smoke.py",
          "--cleanup",
          "$RUNNER_TEMP/county-cleanup.json"
        ]
      ]
    },
    "backend.yml/backend-quality": {
      "Install hash-verified tooling": [
        [
          "python",
          "-m",
          "pip",
          "install",
          "--disable-pip-version-check",
          "--only-binary=:all:",
          "--require-hashes",
          "-r",
          ".github/uv-bootstrap.txt"
        ]
      ],
      "Install locked backend": [
        [
          "uv",
          "lock",
          "--project",
          "backend",
          "--check"
        ],
        [
          "uv",
          "sync",
          "--project",
          "backend",
          "--locked"
        ],
        [
          "uv",
          "pip",
          "check",
          "--python",
          "backend/.venv/bin/python"
        ]
      ],
      "Lint format types and unit tests": [
        [
          "cd",
          "backend"
        ],
        [
          "uv",
          "run",
          "--locked",
          "ruff",
          "check",
          "."
        ],
        [
          "uv",
          "run",
          "--locked",
          "ruff",
          "format",
          "--check",
          "."
        ],
        [
          "uv",
          "run",
          "--locked",
          "mypy"
        ],
        [
          "uv",
          "run",
          "--locked",
          "pytest",
          "-q",
          "-m",
          "not integration",
          "--junitxml=.artifacts/unit.xml"
        ]
      ],
      "Validate and sanitize unit report": [
        [
          "python3",
          "scripts/check_test_report.py",
          "--sanitize",
          "backend/.artifacts/unit.xml"
        ]
      ],
      "Verify lock integrity": [
        [
          "git",
          "diff",
          "--exit-code",
          "--",
          "backend/uv.lock"
        ]
      ]
    },
    "backend.yml/postgresql-integration": {
      "Install hash-verified tooling": [
        [
          "python",
          "-m",
          "pip",
          "install",
          "--disable-pip-version-check",
          "--only-binary=:all:",
          "--require-hashes",
          "-r",
          ".github/uv-bootstrap.txt"
        ]
      ],
      "Install locked backend": [
        [
