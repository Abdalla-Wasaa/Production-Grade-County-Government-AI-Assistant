  "frontend_script_contracts": {
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "build": "tsc -b && vite build",
    "test:e2e": "playwright test",
    "format:check": "prettier --check .",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile=.artifacts/vitest.xml",
    "test:compose": "playwright test --config playwright.compose.config.ts"
  },
