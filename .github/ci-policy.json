        ]
      ],
      "Real PostgreSQL integration and packaged migrations": [
        [
          "cd",
          "backend"
        ],
        [
          "uv",
          "run",
          "--locked",
          "pytest",
          "-q",
          "-m",
          "integration",
          "--junitxml=.artifacts/postgresql.xml"
        ],
        [
          "uv",
          "build",
          "--out-dir",
          "$RUNNER_TEMP/backend-dist"
        ]
      ],
      "Validate and sanitize PostgreSQL report": [
        [
          "python3",
          "scripts/check_test_report.py",
          "--sanitize",
          "backend/.artifacts/postgresql.xml"
        ]
      ]
    },
    "backend.yml/python-dependency-audit": {
      "Install hash-verified tooling": [
        [
          "python",
          "-m",
          "pip",
          "install",
          "--disable-pip-version-check",
          "--only-binary=:all:",
          "--require-hashes",
          "-r",
          ".github/uv-bootstrap.txt"
        ],
        [
          "uv",
          "venv",
